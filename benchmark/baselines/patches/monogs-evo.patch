+def traj_colormap(ax, traj, array, plot_mode, min_map, max_map):
+    """evo 1.11 trajectory coloring with an explicit Matplotlib colorbar axis."""
+    norm = colors.Normalize(vmin=min_map, vmax=max_map, clip=True)
+    mapper = cm.ScalarMappable(norm=norm, cmap=SETTINGS.plot_trajectory_cmap)
+    mapper.set_array(array)
+
+    line_colors = [mapper.to_rgba(value) for value in array]
+    line_collection = plot.colored_line_collection(
+        traj.positions_xyz, line_colors, plot_mode
+    )
+    ax.add_collection(line_collection)
+    ax.autoscale_view(True, True, True)
+
+    if plot_mode == PlotMode.xyz:
+        ax.set_zlim(
+            np.amin(traj.positions_xyz[:, 2]),
+            np.amax(traj.positions_xyz[:, 2]),
+        )
+        if SETTINGS.plot_xyz_realistic:
+            plot.set_aspect_equal_3d(ax)
+
+    midpoint = min_map + (max_map - min_map) / 2
+    cbar = ax.get_figure().colorbar(
+        mapper,
+        ax=ax,
+        ticks=[min_map, midpoint, max_map],
+    )
+    cbar.ax.set_yticklabels(
+        [
+            f"{min_map:0.3f}",
+            f"{midpoint:0.3f}",
+            f"{max_map:0.3f}",
+        ]
+    )
+
