 using namespace dso;
 
+namespace {
+
+struct GpuMemoryStats {
+  double reserved_mb = 0.0;
+  double allocated_mb = 0.0;
+};
+
+GpuMemoryStats getGpuPeakMemoryStats() {
+  GpuMemoryStats stats;
+  if (!torch::cuda::is_available()) return stats;
+
+  namespace allocator = c10::cuda::CUDACachingAllocator;
+  const allocator::DeviceStats device_stats = allocator::getDeviceStats(0);
+  const int aggregate = static_cast<int>(allocator::StatType::AGGREGATE);
+  stats.reserved_mb =
+      device_stats.reserved_bytes[aggregate].peak / (1024.0 * 1024.0);
+  stats.allocated_mb =
+      device_stats.allocated_bytes[aggregate].peak / (1024.0 * 1024.0);
+  return stats;
+}
+
+double fileSizeMb(const std::string& path) {
+  struct stat file_info {};
+  if (stat(path.c_str(), &file_info) != 0) return 0.0;
+  return static_cast<double>(file_info.st_size) / (1024.0 * 1024.0);
+}
+
+size_t countWhitespaceTokens(const std::string& path) {
+  std::ifstream input(path);
+  size_t count = 0;
+  std::string token;
+  while (input >> token) ++count;
+  return count;
+}
+
+size_t countNonEmptyLines(const std::string& path) {
+  std::ifstream input(path);
+  size_t count = 0;
+  std::string line;
+  while (std::getline(input, line)) {
+    if (line.find_first_not_of(" \t\r\n") != std::string::npos) ++count;
+  }
+  return count;
+}
+
+void saveRuntimeMetrics(
+    const std::string& path,
+    int frames,
+    size_t valid_poses,
+    size_t keyframes,
+    double total_seconds,
+    size_t tracking_calls,
+    double tracking_seconds,
+    const std::string& map_path,
+    const GpuMemoryStats& gpu_stats) {
+  std::ofstream output(path, std::ios::trunc);
+  output << std::fixed << std::setprecision(6);
+  output << "{\n";
+  output << "  \"frames\": " << frames << ",\n";
+  output << "  \"valid_poses\": " << valid_poses << ",\n";
+  output << "  \"keyframes\": " << keyframes << ",\n";
+  output << "  \"primitive_type\": \"tsdf_mesh\",\n";
+  output << "  \"total_seconds\": " << total_seconds << ",\n";
+  output << "  \"fps_hz\": "
+         << (total_seconds > 0.0 ? frames / total_seconds : 0.0) << ",\n";
+  output << "  \"tracking_calls\": " << tracking_calls << ",\n";
+  output << "  \"tracking_seconds\": " << tracking_seconds << ",\n";
+  output << "  \"tracking_fps_hz\": "
+         << (tracking_seconds > 0.0 ? tracking_calls / tracking_seconds : 0.0)
+         << ",\n";
+  output << "  \"tracking_scope\": \"DSO trackNewCoarse frontend only\",\n";
+  output << "  \"runtime_scope\": \"tracking, MVS, TSDF fusion, and tail synchronization; input preload, model initialization, and final mesh export excluded\",\n";
+  output << "  \"map_path\": \"" << map_path << "\",\n";
+  output << "  \"map_size_mb\": " << fileSizeMb(map_path) << ",\n";
+  output << "  \"gpu_memory_allocated_mb\": " << gpu_stats.allocated_mb
+         << ",\n";
+  output << "  \"gpu_memory_reserved_mb\": " << gpu_stats.reserved_mb << "\n";
+  output << "}\n";
+}
+
